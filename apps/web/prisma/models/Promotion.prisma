model Promotion {

  id                String @id @default(cuid())

  campaignId        String

  title             String

  description       String?

  type              PromotionType

  active            Boolean @default(true)

  startsAt          DateTime?

  endsAt            DateTime?

  createdAt         DateTime @default(now())

  updatedAt         DateTime @updatedAt

  campaign          Campaign @relation(fields:[campaignId], references:[id])

}
enum PromotionType {

  BUY_X_GET_Y

  DISCOUNT

  BONUS

  COUPON

  CASHBACK

}