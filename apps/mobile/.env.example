# Somente API isolada. Sem senha, token administrativo ou conexão de banco.
EXPO_PUBLIC_API_URL=https://sortex-fase1-review.netlify.app/.netlify/functions/sortex-api
# Ative só para uma candidata ligada a dados sintéticos isolados. Não inicia pagamentos.
EXPO_PUBLIC_ENABLE_TEST_RESERVATIONS=0
# Pix nativo de teste: permanece desativado sem ambiente verificado.
EXPO_PUBLIC_ENABLE_NATIVE_SANDBOX_PIX=0
