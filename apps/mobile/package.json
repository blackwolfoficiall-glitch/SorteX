{
  "name": "@sortex/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/core.test.ts tests/organizer-draft.test.ts tests/buyer-purchases.test.ts tests/public-draw-proof.test.ts tests/hosted-smoke-preflight.test.ts tests/public-campaign-cover.test.ts tests/native-pagination-layout.test.ts tests/buyer-prizes.test.ts tests/buyer-draw-results.test.ts tests/organizer-finance.test.ts tests/organizer-campaign-lifecycle.test.ts tests/organizer-draft-cover.test.ts tests/buyer-inbox.test.ts tests/organizer-draft-prizes.test.ts tests/buyer-favorites.test.ts tests/buyer-order-history.test.ts tests/organizer-dashboard.test.ts",
    "export:test": "expo export --platform android --platform ios",
    "test:api": "node --import tsx scripts/test-api.ts"
  },
  "dependencies": {
    "expo": "~58.0.26",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "@react-navigation/bottom-tabs": "^7.3.0",
    "expo-secure-store": "~58.0.3",
    "expo-auth-session": "~58.0.19",
    "expo-web-browser": "~58.1.0",
    "expo-crypto": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-dev-client": "~58.0.21",
    "expo-splash-screen": "~58.0.14",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-dom": "19.3.0",
    "expo-apple-authentication": "~58.0.3",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "58.0.5"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "tsx": "^4.20.0",
    "@types/node": "^24.0.0"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "expo-apple-authentication"
        ]
      }
    }
  }
}
