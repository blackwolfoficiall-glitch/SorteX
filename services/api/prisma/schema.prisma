model User {
  id                         String                    @id @default(cuid())
  name                       String
  email                      String                    @unique
  password                   String
  phone                      String?
  cpf                        String?                   @unique
  cnpj                       String?                   @unique
  role                       UserRole                  @default(BUYER)
  city                       String?
  state                      String?
  isActive                   Boolean                   @default(true)
  status                     UserStatus                @default(ACTIVE)
  adminPermissions           AdminPermission[]
  adminTeamRole              AdminTeamRole?
  forcePasswordReset         Boolean                   @default(false)
  failedLoginAttempts        Int                       @default(0)
  lockedUntil                DateTime?
  lastAccessAt               DateTime?
  deletedAt                  DateTime?
  verified                   Boolean                   @default(false)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  sessions                   AuthSession[]
  passwordResetTokens        PasswordResetToken[]
  organizerProfile           OrganizerProfile?
  campaigns                  Campaign[]
  drawRuleTemplates          DrawRuleTemplate[]
  purchases                  Purchase[]
  tickets                    Ticket[]
  paymentsAsBuyer            Payment[]                 @relation("PaymentBuyer")
  paymentsAsOrganizer        Payment[]                 @relation("PaymentOrganizer")
  enteredLotteryDraws        LotteryDraw[]             @relation("LotteryDrawEnteredBy")
  reviewedLotteryDraws       LotteryDraw[]             @relation("LotteryDrawReviewedBy")
  executedCampaignDraws      CampaignDraw[]            @relation("CampaignDrawExecutedBy")
  confirmedCampaignDraws     CampaignDraw[]            @relation("CampaignDrawConfirmedBy")
  winners                    Winner[]
  instantPrizeResults        InstantPrizeResult[]
  auditLogs                  AuditLog[]                @relation("AuditLogActor")
  payoutRequests             PayoutRequest[]           @relation("PayoutOrganizer")
  reviewedPayouts            PayoutRequest[]           @relation("PayoutReviewer")
  createdAdjustments         FinancialAdjustment[]     @relation("AdjustmentCreator")
  approvedAdjustments        FinancialAdjustment[]     @relation("AdjustmentApprover")
  subscriptions              Subscription[]
  notifications              Notification[]
  favorites                  BuyerFavorite[]
  affiliateMemberships       Affiliate[]               @relation("AffiliateUser")
  organizerAffiliatePrograms AffiliateProgram[]
  affiliateClicks            AffiliateClick[]
  referralsMade              Referral[]                @relation("ReferralReferrer")
  referralReceived           Referral?                 @relation("ReferralReferred")
  crmContacts                CrmContact[]
  notificationPreferences    NotificationPreference[]
  organizerBrandProfile      OrganizerBrandProfile?
  organizerSocialLinks       OrganizerSocialLink[]
  organizerCommunities       OrganizerCommunityLink[]
  organizerDomains           OrganizerDomain[]
  organizerIntegrations      OrganizerIntegration[]
  campaignTemplates          CampaignTemplate[]        @relation("CampaignTemplateOrganizer")
  miniCampaigns              MiniCampaign[]            @relation("MiniCampaignOrganizer")
  miniCampaignOrders         MiniCampaignOrder[]       @relation("MiniCampaignOrderBuyer")
  miniCampaignResults        MiniCampaignResult[]      @relation("MiniCampaignWinner")
  sortexAds                  SortexAdCampaign[]        @relation("SortexAdOrganizer")
  aiRecommendations          AiRecommendation[]        @relation("AiRecommendationOrganizer")
  promotionCredits           PromotionalCredit[]       @relation("PromotionalCreditBuyer")
  consentRecords             ConsentRecord[]
  dataSubjectRequests        DataSubjectRequest[]
  legalDocumentsCreated      LegalDocument[]           @relation("LegalDocumentCreatedBy")
  legalDocumentsUpdated      LegalDocument[]           @relation("LegalDocumentUpdatedBy")
  legalDocumentVersions      LegalDocumentVersion[]
  legalAcceptances           LegalAcceptance[]
  executedCampaignMilestones CampaignMilestonePrize[]  @relation("CampaignMilestoneExecutedBy")
  organizerReviewDecisions   OrganizerReviewDecision[] @relation("OrganizerReviewDecisionAdmin")
  organizerInternalNotes     OrganizerInternalNote[]   @relation("OrganizerInternalNoteAuthor")
  organizerFeeChanges        OrganizerFeeHistory[]     @relation("OrganizerFeeHistoryAdmin")
  adminInvitesSent           AdminTeamInvitation[]     @relation("AdminInvitationInviter")
  adminInviteAccepted        AdminTeamInvitation[]     @relation("AdminInvitationAcceptedUser")
}

model AdminTeamInvitation {
  id             String                @id @default(cuid())
  name           String
  email          String
  tokenHash      String                @unique
  role           AdminTeamRole
  permissions    AdminPermission[]
  message        String?
  status         AdminInvitationStatus @default(PENDING)
  expiresAt      DateTime
  invitedById    String
  acceptedUserId String?
  acceptedAt     DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  invitedBy      User                  @relation("AdminInvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedUser   User?                 @relation("AdminInvitationAcceptedUser", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([invitedById, createdAt])
  @@index([expiresAt, status])
}

model Campaign {
  id                             String                    @id @default(cuid())
  organizerId                    String
  title                          String
  slug                           String                    @unique
  shortDescription               String?
  description                    String?
  regulation                     String?
  status                         CampaignStatus            @default(DRAFT)
  category                       CampaignCategory          @default(OTHER)
  mainPrizeName                  String?
  mainPrizeDescription           String?
  mainPrizeImage                 String?
  mainPrizeQuantity              Int                       @default(1)
  cashAlternative                Decimal?                  @db.Decimal(14, 2)
  estimatedPrizeValue            Decimal?                  @db.Decimal(14, 2)
  coverImage                     String?
  promotionalVideo               String?
  totalNumbers                   Int                       @default(10000)
  numberPrice                    Decimal                   @default(0.1) @db.Decimal(14, 2)
  minimumPurchase                Int                       @default(1)
  maximumPurchasePerBuyer        Int?
  numberSelectionMode            NumberSelectionMode       @default(RANDOM)
  drawDate                       DateTime?
  drawTime                       String?
  drawBasis                      DrawBasis                 @default(LOTERIA_FEDERAL)
  drawRuleTemplateId             String?
  customDrawRule                 Json?
  salesStartAt                   DateTime?
  salesEndAt                     DateTime?
  soldNumbers                    Int                       @default(0)
  reservedNumbers                Int                       @default(0)
  grossRevenue                   Decimal                   @default(0) @db.Decimal(16, 2)
  publishedAt                    DateTime?
  createdAt                      DateTime                  @default(now())
  updatedAt                      DateTime                  @updatedAt
  organizer                      User                      @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  drawRuleTemplate               DrawRuleTemplate?         @relation(fields: [drawRuleTemplateId], references: [id], onDelete: SetNull)
  galleryImages                  CampaignImage[]
  instantPrizes                  CampaignInstantPrize[]
  promotions                     CampaignPromotion[]
  purchases                      Purchase[]
  tickets                        Ticket[]
  payments                       Payment[]
  platformFeeWaived              Boolean                   @default(false)
  customPlatformFee              Decimal?                  @db.Decimal(6, 3)
  publishedRuleSnapshot          Json?
  unsoldNumberPolicy             UnsoldNumberPolicy        @default(MANUAL_REVIEW)
  draws                          CampaignDraw[]
  winners                        Winner[]
  instantPrizeResults            InstantPrizeResult[]
  ledgerEntries                  LedgerEntry[]
  financialSummary               CampaignFinancialSummary?
  isFeatured                     Boolean                   @default(false)
  purchasesBlocked               Boolean                   @default(false)
  publicationBlocked             Boolean                   @default(false)
  adminReviewStatus              String?
  adminNotes                     String?
  favorites                      BuyerFavorite[]
  affiliatePrograms              AffiliateProgram[]
  affiliateLinks                 AffiliateLink[]
  affiliateConversions           AffiliateConversion[]
  affiliateCoupons               AffiliateCoupon[]
  affiliateMaterials             AffiliateMaterial[]
  crmInteractions                CrmInteraction[]
  generatedMedia                 GeneratedMedia[]
  mediaAssets                    MediaAsset[]
  shareLinks                     ShareLink[]
  customization                  CampaignCustomization?
  templates                      CampaignTemplate[]
  miniCampaigns                  MiniCampaign[]
  sortexAds                      SortexAdCampaign[]
  aiRecommendations              AiRecommendation[]
  milestonePrizes                CampaignMilestonePrize[]
  milestoneWinnersRemainEligible Boolean                   @default(true)

  @@index([organizerId])
  @@index([status])
  @@index([category])
  @@index([publishedAt])
}

model BuyerFavorite {
  id         String   @id @default(cuid())
  buyerId    String
  campaignId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  buyer      User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([buyerId, campaignId])
  @@index([buyerId, createdAt])
  @@index([campaignId])
}

model ConsentRecord {
  id            String      @id @default(cuid())
  userId        String
  type          ConsentType
  version       String
  granted       Boolean
  ipHash        String?
  userAgentHash String?
  grantedAt     DateTime    @default(now())
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, type, grantedAt])
}

model DataSubjectRequest {
  id           String                   @id @default(cuid())
  userId       String
  type         DataSubjectRequestType
  status       DataSubjectRequestStatus @default(OPEN)
  reason       String?
  requestedAt  DateTime                 @default(now())
  reviewedAt   DateTime?
  completedAt  DateTime?
  reviewedById String?
  notes        String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  user         User                     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status, requestedAt])
  @@index([status, requestedAt])
}

model LegalDocument {
  id            String                 @id @default(cuid())
  title         String
  subtitle      String?
  slug          String                 @unique
  category      String
  content       Json
  changeSummary String?
  version       Int                    @default(1)
  status        LegalDocumentStatus    @default(DRAFT)
  required      Boolean                @default(false)
  publishedAt   DateTime?
  createdAt     DateTime               @default(now())
