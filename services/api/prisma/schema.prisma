  financialAccountId  String
  amount              Decimal               @db.Decimal(18, 2)
  fee                 Decimal?              @db.Decimal(18, 2)
  netAmount           Decimal               @db.Decimal(18, 2)
  status              PayoutStatus          @default(REQUESTED)
  requestedAt         DateTime              @default(now())
  reviewedAt          DateTime?
  reviewedByUserId    String?
  rejectionReason     String?
  approvedAt          DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  destinationType     PayoutDestinationType
  destinationSnapshot Json
  externalReference   String?               @unique
  notes               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  organizer           User                  @relation("PayoutOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  reviewedBy          User?                 @relation("PayoutReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  financialAccount    FinancialAccount      @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  ledgerEntries       LedgerEntry[]

  @@index([organizerId, status])
  @@index([status, requestedAt])
}

model FinancialAdjustment {
  id               String           @id @default(cuid())
  organizerId      String?
  accountId        String
  amount           Decimal          @db.Decimal(18, 2)
  direction        LedgerDirection
  reason           String
  notes            String?
  createdByUserId  String
  approvedByUserId String?
  createdAt        DateTime         @default(now())
  account          FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdBy        User             @relation("AdjustmentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy       User?            @relation("AdjustmentApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([organizerId, createdAt])
}

model CampaignFinancialSummary {
  id               String   @id @default(cuid())
  campaignId       String   @unique
  organizerId      String
  grossRevenue     Decimal  @default(0) @db.Decimal(18, 2)
  approvedPayments Int      @default(0)
  pendingPayments  Int      @default(0)
  rejectedPayments Int      @default(0)
  refundedAmount   Decimal  @default(0) @db.Decimal(18, 2)
  chargebackAmount Decimal  @default(0) @db.Decimal(18, 2)
  platformFees     Decimal  @default(0) @db.Decimal(18, 2)
  gatewayFees      Decimal  @default(0) @db.Decimal(18, 2)
  netRevenue       Decimal  @default(0) @db.Decimal(18, 2)
  availableBalance Decimal  @default(0) @db.Decimal(18, 2)
  pendingBalance   Decimal  @default(0) @db.Decimal(18, 2)
  updatedAt        DateTime @updatedAt
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([organizerId, updatedAt])
}

model Subscription {
  id                 String                @id @default(cuid())
  organizerId        String
  plan               OrganizerPlan
  planId             String?
  billingCycle       PlanBillingCycle      @default(MONTHLY)
  sandboxMode        Boolean               @default(true)
  autoRenew          Boolean               @default(true)
  nextRenewalAt      DateTime?
  status             SubscriptionStatus    @default(TRIAL)
  monthlyPrice       Decimal               @db.Decimal(14, 2)
  startedAt          DateTime              @default(now())
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  organizer          User                  @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  selectedPlan       Plan?                 @relation(fields: [planId], references: [id], onDelete: SetNull)
  invoices           SubscriptionInvoice[]

  @@index([organizerId, status])
  @@index([planId, status])
}

model SubscriptionInvoice {
  id             String        @id @default(cuid())
  subscriptionId String
  organizerId    String
  amount         Decimal       @db.Decimal(14, 2)
  status         InvoiceStatus @default(OPEN)
  dueDate        DateTime
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizerId, status])
  @@index([dueDate, status])
}

model OrganizerProfile {
  id                       String                    @id @default(cuid())
  userId                   String                    @unique
  fullName                 String
  cpf                      String
  phone                    String
  birthDate                DateTime?
  organizationName         String?
  cnpj                     String?
  instagram                String?
  postalCode               String?
  address                  String?
  addressNumber            String?
  addressComplement        String?
  neighborhood             String?
  municipalityCode         String?
  addressReference         String?
  city                     String?
  state                    String?
  logoStorageKey           String?
  logoOriginalName         String?
  logoMimeType             String?
  verificationStatus       VerificationStatus        @default(PENDING)
  rejectionReason          String?
  submittedAt              DateTime?
  reviewedAt               DateTime?
  reviewedById             String?
  assignedAdminId          String?
  publicReviewMessage      String?
  correctionDeadline       DateTime?
  riskLevel                OrganizerRiskLevel        @default(MANUAL_REVIEW)
  riskScore                Int                       @default(0)
  riskReasons              Json?
  riskAnalyzedAt           DateTime?
  reviewChecklist          Json?
  analysisStartedAt        DateTime?
  suspensionEndsAt         DateTime?
  readOnlyAccess           Boolean                   @default(false)
  currentPlan              OrganizerPlan             @default(BASIC)
  onboardingStatus         OrganizerOnboardingStatus @default(PLAN_SELECTION)
  planSelectedAt           DateTime?
  identitySetupCompletedAt DateTime?
  platformFee              Decimal                   @default(2.9) @db.Decimal(5, 2)
  monthlyFee               Decimal                   @default(29.9) @db.Decimal(12, 2)
  firstCampaignFree        Boolean                   @default(true)
  platformFeeWaived        Boolean                   @default(false)
  monthlyFeeWaived         Boolean                   @default(false)
  customPlatformFee        Decimal?                  @db.Decimal(5, 2)
  founder                  Boolean                   @default(false)
  vip                      Boolean                   @default(false)
  campaignsBlocked         Boolean                   @default(false)
  paymentsBlocked          Boolean                   @default(false)
  payoutsBlocked           Boolean                   @default(false)
  internalNotes            String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents                OrganizerDocument[]
  reviewDecisions          OrganizerReviewDecision[]
  internalNoteEntries      OrganizerInternalNote[]
  feeHistory               OrganizerFeeHistory[]

  @@index([verificationStatus])
  @@index([currentPlan])
}

model OrganizerDocument {
  id                 String                  @id @default(cuid())
  organizerProfileId String
  type               OrganizerDocumentType
  originalName       String
  storageKey         String
  mimeType           String
  size               Int
  status             OrganizerDocumentStatus @default(SUBMITTED)
  reviewedById       String?
  reviewedAt         DateTime?
  rejectionReason    String?
  reviewNote         String?
  version            Int                     @default(1)
  expiresAt          DateTime?
  createdAt          DateTime                @default(now())
  organizerProfile   OrganizerProfile        @relation(fields: [organizerProfileId], references: [id], onDelete: Cascade)

  @@unique([organizerProfileId, type, version])
  @@index([organizerProfileId])
  @@index([type])
}

model OrganizerReviewDecision {
  id                 String             @id @default(cuid())
  organizerProfileId String
  adminId            String
  previousStatus     VerificationStatus
  nextStatus         VerificationStatus
  reason             String
  requestedFields    Json?
  requestedDocuments Json?
  deadline           DateTime?
  canResubmit        Boolean            @default(true)
  createdAt          DateTime           @default(now())
  organizerProfile   OrganizerProfile   @relation(fields: [organizerProfileId], references: [id], onDelete: Restrict)
  admin              User               @relation("OrganizerReviewDecisionAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([organizerProfileId, createdAt])
  @@index([adminId, createdAt])
}

model OrganizerInternalNote {
  id                 String                        @id @default(cuid())
  organizerProfileId String
  authorId           String
  category           OrganizerInternalNoteCategory @default(GENERAL)
  text               String
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  organizerProfile   OrganizerProfile              @relation(fields: [organizerProfileId], references: [id], onDelete: Restrict)
  author             User                          @relation("OrganizerInternalNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([organizerProfileId, createdAt])
}

model OrganizerFeeHistory {
  id                 String              @id @default(cuid())
  organizerProfileId String
  adminId            String
  ruleType           PlatformFeeRuleType
  previousRate       Decimal?            @db.Decimal(6, 3)
  newRate            Decimal             @db.Decimal(6, 3)
  startsAt           DateTime            @default(now())
  endsAt             DateTime?
  reason             String
  campaignId         String?
  createdAt          DateTime            @default(now())
  organizerProfile   OrganizerProfile    @relation(fields: [organizerProfileId], references: [id], onDelete: Restrict)
  admin              User                @relation("OrganizerFeeHistoryAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([organizerProfileId, createdAt])
  @@index([campaignId])
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Plan {
  id              String         @id @default(cuid())
  code            String         @unique
  name            String
  description     String?
  monthlyPrice    Decimal        @db.Decimal(14, 2)
  annualPrice     Decimal?       @db.Decimal(14, 2)
  platformFeeRate Decimal        @db.Decimal(6, 3)
  campaignLimit   Int?
  ticketLimit     Int?
  teamMemberLimit Int?
  trialDays       Int            @default(0)
  isActive        Boolean        @default(true)
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  features        PlanFeature[]
  subscriptions   Subscription[]
}

model AdminGatewayConfig {
  id                   String             @id @default(cuid())
  provider             GatewayProvider    @unique
  displayName          String
  status               AdminGatewayStatus @default(INACTIVE)
  sandboxEnabled       Boolean            @default(true)
  productionEnabled    Boolean            @default(false)
  splitAvailable       Boolean            @default(false)
  planBillingAvailable Boolean            @default(false)
  priority             Int                @default(0)
  estimatedFeeRate     Decimal            @default(0) @db.Decimal(6, 3)
  collectionModel      String             @default("CONSOLIDATED")
  lastCheckedAt        DateTime?
  lastError            String?
  updatedByUserId      String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status, priority])
}

model MiniCampaign {
  id                    String                @id @default(cuid())
  organizerId           String
  mainCampaignId        String
  name                  String
  slug                  String                @unique
  description           String?
  imageUrl              String?
  prizeType             MiniCampaignPrizeType
  prizeDescription      String
  maxTickets            Int
  ticketPrice           Decimal               @db.Decimal(14, 2)
  purchaseLimitPerBuyer Int?
  startsAt              DateTime?
  endsAt                DateTime?
  drawAt                DateTime?
  rules                 String
  status                MiniCampaignStatus    @default(DRAFT)
  soldTickets           Int                   @default(0)
  grossRevenue          Decimal               @default(0) @db.Decimal(16, 2)
  publishedAt           DateTime?
  finishedAt            DateTime?
  deletedAt             DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  organizer             User                  @relation("MiniCampaignOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  mainCampaign          Campaign              @relation(fields: [mainCampaignId], references: [id], onDelete: Restrict)
  orders                MiniCampaignOrder[]
  tickets               MiniCampaignTicket[]
  result                MiniCampaignResult?

  @@index([organizerId, status, updatedAt])
  @@index([mainCampaignId, status])
}

model MiniCampaignOrder {
  id             String                  @id @default(cuid())
  miniCampaignId String
  buyerId        String
  code           String                  @unique
  status         MiniCampaignOrderStatus @default(RESERVED)
  quantity       Int
  unitPrice      Decimal                 @db.Decimal(14, 2)
  total          Decimal                 @db.Decimal(14, 2)
  expiresAt      DateTime?
  paidAt         DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  miniCampaign   MiniCampaign            @relation(fields: [miniCampaignId], references: [id], onDelete: Restrict)
  buyer          User                    @relation("MiniCampaignOrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  tickets        MiniCampaignTicket[]

  @@index([miniCampaignId, status, createdAt])
  @@index([buyerId, status, createdAt])
}

model MiniCampaignTicket {
  id             String            @id @default(cuid())
  miniCampaignId String
  orderId        String
  number         Int
  createdAt      DateTime          @default(now())
  miniCampaign   MiniCampaign      @relation(fields: [miniCampaignId], references: [id], onDelete: Restrict)
  order          MiniCampaignOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([miniCampaignId, number])
  @@index([orderId])
}

model MiniCampaignResult {
  id             String       @id @default(cuid())
  miniCampaignId String       @unique
  winningNumber  Int
  winnerId       String?
  notes          String?
  auditedData    Json?
  drawnAt        DateTime     @default(now())
  confirmedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  miniCampaign   MiniCampaign @relation(fields: [miniCampaignId], references: [id], onDelete: Restrict)
  winner         User?        @relation("MiniCampaignWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  @@index([winnerId, drawnAt])
}

model PlanFeature {
  id     String @id @default(cuid())
  planId String
  key    String
  name   String
  value  Json
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
}

model OrganizerCommercialOverride {
  id                 String    @id @default(cuid())
  organizerId        String    @unique
  promotionalStartAt DateTime?
  promotionalEndAt   DateTime?
  notes              String?
  campaignLimit      Int?
  ticketLimit        Int?
  enabledFeatures    Json?
  updatedByUserId    String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Report {
  id               String           @id @default(cuid())
  reporterUserId   String?
  entityType       ReportEntityType
  entityId         String
  reason           String
  description      String
  status           ReportStatus     @default(OPEN)
  reviewedByUserId String?
  reviewedAt       DateTime?
  resolution       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([entityType, entityId])
}

model PlatformBanner {
  id              String    @id @default(cuid())
  title           String
  subtitle        String?
  imageUrl        String?
  linkUrl         String?
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  startsAt        DateTime?
  endsAt          DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model FeaturedCampaign {
  id              String    @id @default(cuid())
  campaignId      String    @unique
  sortOrder       Int       @default(0)
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean   @default(true)
  createdByUserId String
  createdAt       DateTime  @default(now())
}

model PlatformNotice {
  id              String    @id @default(cuid())
  title           String
  message         String
  level           String    @default("INFO")
  isActive        Boolean   @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ContentPage {
  id              String          @id @default(cuid())
  slug            String          @unique
  title           String
  type            ContentPageType
  content         String
  isPublished     Boolean         @default(false)
  updatedByUserId String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model PlatformSetting {
  key             String   @id
  value           Json
  category        String
  description     String?
  isPublic        Boolean  @default(false)
  updatedByUserId String
  updatedAt       DateTime @updatedAt

  @@index([category])
}

model SupportTicket {
  id              String           @id @default(cuid())
  requesterUserId String
  assignedAdminId String?
  category        SupportCategory
  subject         String
  description     String
  status          SupportStatus    @default(OPEN)
  priority        SupportPriority  @default(MEDIUM)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  closedAt        DateTime?
  messages        SupportMessage[]

  @@index([status, priority, createdAt])
  @@index([requesterUserId])
}

model SupportMessage {
  id            String        @id @default(cuid())
  ticketId      String
  senderUserId  String
  message       String
  attachmentUrl String?
  createdAt     DateTime      @default(now())
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  data      Json?
  readAt    DateTime?
  deletedAt DateTime?
  category  NotificationCategory @default(SYSTEM)
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}
