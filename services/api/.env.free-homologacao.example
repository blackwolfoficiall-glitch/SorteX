# No real values. Set private values directly in the hosting dashboard.
NODE_ENV=production
APP_ENV=staging
PORT=3333
DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
INTEGRATION_ENCRYPTION_KEY=
WEB_URL=
APP_URL=
WEB_APP_URL=
PUBLIC_WEB_URL=
API_URL=
CORS_ALLOWED_ORIGINS=
PAYMENT_ENV=sandbox
INTEGRATIONS_MODE=sandbox
EMAIL_DELIVERY_MODE=disabled
# Keep disabled until a durable volume with write permissions has been verified.
UPLOADS_DISABLED=true
ORGANIZER_UPLOAD_DIR=/app/storage/organizers
FEATURE_REAL_PAYMENTS=false
FEATURE_REAL_DRAWS=false
FEATURE_PAYOUTS=false
FEATURE_EXTERNAL_CRM=false
FEATURE_WHATSAPP=false
FEATURE_VIDEO_RENDERING=false
# Do not set Mercado Pago, SMTP, Meta or OpenAI production credentials here.
